@startuml clases-monitoreo
skinparam style strictuml
skinparam classAttributeIconSize 0
skinparam shadowing false
title RutaSIT Arequipa — Diagrama de clases del módulo de monitoreo (HU-01)

enum EstadoViaje {
    PROGRAMADO
    EN_RUTA
    DESVIADO
    DETENIDO
    FINALIZADO
}

' Puertos (ADR-001: integraciones externas mediante interfaces)
interface IProveedorGPS <<puerto>> {
    + obtenerCoordenadaActual(idBus: String): Coordenada
}

interface IServicioMapas <<puerto>> {
    + calcularETA(origen: Coordenada, destino: Coordenada): Integer
}

interface INotificador <<puerto>> {
    + notificarRetraso(viaje: Viaje): void
}

' Adaptadores que realizan los puertos
class ProveedorGPSAdapter <<adaptador>>
class ServicioMapasAdapter <<adaptador>>
class WebPushAdapter <<adaptador>>

class AppPasajero <<interfaz de usuario>> {
    + consultarETA(paradero: Paradero): void
    + mostrarResultado(eta: Integer): void
}

class Pasajero {
    - idPasajero: String
    - ubicacionActual: Coordenada
}

class Paradero {
    - idParadero: String
    - nombre: String
    - ubicacion: Coordenada
    + obtenerViajesProximos(): List<Viaje>
}

class Bus {
    - idBus: String
    - placa: String
    - capacidad: Integer
    - ubicacionActual: Coordenada
    + actualizarUbicacion(coord: Coordenada): void
}

class Ruta {
    - idRuta: String
    - nombre: String
    + obtenerParaderos(): List<Paradero>
}

class Viaje {
    - idViaje: String
    - estado: EstadoViaje
    - horaInicioProgramada: DateTime
    + programar(): void
    + cambiarEstado(nuevoEstado: EstadoViaje): void
    + calcularTiempoLlegada(destino: Paradero): Integer
    + registrarContingencia(motivo: String): void
}

class Coordenada <<datatype>> {
    - latitud: Double
    - longitud: Double
}

class ServicioMonitoreoSIT <<servicio>> {
    + solicitarETA(pasajero: Pasajero, paradero: Paradero): Integer
    + procesarAlertaDesvio(viaje: Viaje): void
}

' Realizaciones (puerto <- adaptador)
IProveedorGPS <|.. ProveedorGPSAdapter
IServicioMapas <|.. ServicioMapasAdapter
INotificador <|.. WebPushAdapter

' Dependencias de uso
AppPasajero ..> ServicioMonitoreoSIT : usa >
ServicioMonitoreoSIT ..> IProveedorGPS : usa >
ServicioMonitoreoSIT ..> INotificador : usa >
Viaje ..> IServicioMapas : usa >

' Asociaciones con multiplicidad en ambos extremos
Pasajero "1" -- "0..*" AppPasajero : utiliza >
Ruta "1" o-- "2..*" Paradero : recorre >
Bus "1" -- "0..*" Viaje : realiza >
Ruta "1" -- "0..*" Viaje : define >
Viaje "0..*" --> "1" EstadoViaje : se encuentra en >
Paradero "0..*" -- "0..*" Viaje : es atendido por >
ServicioMonitoreoSIT "1" -- "0..*" Viaje : monitorea >

@enduml
