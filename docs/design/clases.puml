@startuml
title RutaSIT Arequipa - Monitoreo refactorizado (Lab 07)
skinparam classAttributeIconSize 0
skinparam shadowing false
class Bus
class Paradero
class Viaje <<Context>> {
  +estado: str
  +validar_disponibilidad_eta(eventos)
}
class ServicioMonitoreoSIT <<Service>> {
  +consultar_tiempo_llegada(viaje, tipo_algoritmo)
  +explicar_retraso(motivo, minutos_retraso)
}
interface IEstrategiaETA <<Strategy>>
class ETALinealStrategy
class ETAHoraPuntaStrategy
class ETAParadasIntermediasStrategy
class FabricaEstrategiasETA <<Factory>>
interface IProveedorGPS <<Target>>
class GPSOperadorAAdapter <<Adapter>>
class GPSOperadorBAdapter <<Adapter>>
class FabricaProveedoresGPS <<Factory>>
class ReintentoGPSDecorator <<Decorator>>
abstract class EstadoViajeState <<State>>
class ProgramadoState
class EnRutaState
class DetenidoState
class DesviadoState
class FinalizadoState
class PublicadorEventos <<Subject>>
interface ISuscriptor <<Observer>>
class ServicioExplicacionIA
interface IProveedorLLM <<Strategy>>
class MockLLMAdapter <<Adapter>>
class CacheIADecorator <<Decorator>>
abstract class IGuardrail <<Handler>>
class GuardrailConsistenciaTelemetria
class GuardrailLongitudYTono
Viaje --> Bus
Viaje --> Paradero
Viaje --> EstadoViajeState
ServicioMonitoreoSIT --> Viaje
ServicioMonitoreoSIT --> FabricaEstrategiasETA
ServicioMonitoreoSIT --> FabricaProveedoresGPS
ServicioMonitoreoSIT --> PublicadorEventos
ServicioMonitoreoSIT --> ServicioExplicacionIA
FabricaEstrategiasETA ..> IEstrategiaETA
IEstrategiaETA <|.. ETALinealStrategy
IEstrategiaETA <|.. ETAHoraPuntaStrategy
IEstrategiaETA <|.. ETAParadasIntermediasStrategy
FabricaProveedoresGPS ..> IProveedorGPS
IProveedorGPS <|.. GPSOperadorAAdapter
IProveedorGPS <|.. GPSOperadorBAdapter
IProveedorGPS <|.. ReintentoGPSDecorator
ReintentoGPSDecorator o--> IProveedorGPS
EstadoViajeState <|-- ProgramadoState
EstadoViajeState <|-- EnRutaState
EstadoViajeState <|-- DetenidoState
EstadoViajeState <|-- DesviadoState
EstadoViajeState <|-- FinalizadoState
PublicadorEventos o--> ISuscriptor
ServicioExplicacionIA --> IProveedorLLM
ServicioExplicacionIA --> IGuardrail
IProveedorLLM <|.. MockLLMAdapter
IProveedorLLM <|.. CacheIADecorator
CacheIADecorator o--> IProveedorLLM
IGuardrail <|-- GuardrailConsistenciaTelemetria
IGuardrail <|-- GuardrailLongitudYTono
IGuardrail o--> IGuardrail : siguiente
@enduml
