@startuml secuencia-consultar-tiempo
skinparam style strictuml
skinparam shadowing false
skinparam sequenceMessageAlign center
autonumber
title HU-01 — Consultar el tiempo de llegada del bus

actor Pasajero
participant "AppPasajero" as UI
participant "ServicioMonitoreoSIT" as S
participant "Paradero" as P
participant "Viaje" as V
participant "Bus" as B
participant "IProveedorGPS" as G
participant "IServicioMapas" as M
participant "INotificador" as N

Pasajero -> UI : selecciona paradero
UI -> S : solicitarETA(pasajero, paradero)
activate S

S -> P : obtenerViajesProximos()
P --> S : listaViajes

alt listaViajes no está vacía
    loop por cada viaje en listaViajes
        S -> G : obtenerCoordenadaActual(idBus)
        G --> S : coordenada
        S -> B : actualizarUbicacion(coordenada)
        S -> V : calcularTiempoLlegada(paradero)
        activate V
        alt estado == EN_RUTA
            V -> M : calcularETA(ubicacionActual, paradero.ubicacion)
            M --> V : tiempoMinutos
            V --> S : tiempoMinutos
            deactivate V
        else estado == DESVIADO o DETENIDO
            V --> S : null (retrasado)
            deactivate V
            S -> S : procesarAlertaDesvio(viaje)
            S ->> N : notificarRetraso(viaje)
            note right of N : asíncrono\n(no bloquea la respuesta)
        end
    end
    S --> UI : tiempoMinutos o "Retrasado"
else listaViajes está vacía
    S --> UI : null ("No hay buses aproximándose")
end

UI -> UI : mostrarResultado(eta)
UI --> Pasajero : muestra el resultado
deactivate S

@enduml
